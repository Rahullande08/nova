# ==============================================================================
# Practice Layer — Environment Configuration Template (.env.example)
# Copy to .env for local overrides. NEVER commit .env with real secrets.
# ==============================================================================

# Server Environment
PORT=8000
ENVIRONMENT=development
DEBUG=true

# Database Connection
# SQLite (Default local development/demo):
DATABASE_URL=sqlite:///./practice_layer.db
# PostgreSQL (Production cloud deployment):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/practice_layer

# Security & Authentication
# Change SECRET_KEY in production deployment:
SECRET_KEY=practice_layer_change_in_production_secret_key_2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Practice Diagnostic & ASR Providers
# Provide GEMINI_API_KEY to activate real cloud vision analysis and speech transcription.
# When empty or omitted, the system operates seamlessly with high-fidelity domain fallbacks.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AI_TIMEOUT_SECONDS=15

# WhatsApp Integration (Optional Cloud API)
# When empty, generates direct pre-filled WhatsApp links (wa.me) for instant mentor sharing.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Storage & Institutional Privacy Policy
UPLOAD_DIR=./backend/uploads
MAX_UPLOAD_SIZE_MB=25
PURGE_AUDIO_AFTER_TRANSCRIPTION=false
STORE_CHILD_FACES=false

# Frontend Base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1
