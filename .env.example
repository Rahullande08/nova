# Practice Layer Environment Configuration Example

# API Server
PORT=8000
ENVIRONMENT=development
DEBUG=true

# Database Connection (SQLite default, or PostgreSQL: postgresql://user:pass@localhost:5432/practicelayer)
DATABASE_URL=sqlite:///./practice_layer.db

# Security & Tokens
SECRET_KEY=practice_layer_change_in_production_secret_key_2026

# AI Engine Integration (Optional: Gemini 1.5/2.0 or OpenAI)
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Storage & Privacy
UPLOAD_DIR=./backend/uploads
PURGE_AUDIO_AFTER_TRANSCRIPTION=false
STORE_CHILD_FACES=false

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
